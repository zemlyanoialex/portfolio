rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read for portfolio images so path-based URLs work without tokens.
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Public read for client logos.
    match /client/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
